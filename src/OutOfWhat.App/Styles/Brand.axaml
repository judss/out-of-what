<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Out Of What — Design Tokens v1 -->

    <!-- Primary -->
    <Color x:Key="ColorPrimary">#7C5CFF</Color>
    <Color x:Key="ColorPrimaryHover">#8E72FF</Color>
    <Color x:Key="ColorPrimaryPressed">#6948F5</Color>

    <!-- Backgrounds -->
    <Color x:Key="ColorBg">#18181B</Color>
    <Color x:Key="ColorSurface">#222228</Color>
    <Color x:Key="ColorPopup">#2A2A31</Color>
    <Color x:Key="ColorHover">#32323A</Color>
    <Color x:Key="ColorBorder">#3E3E47</Color>

    <!-- Text -->
    <Color x:Key="ColorText">#F4F4F5</Color>
    <Color x:Key="ColorTextSecondary">#B8B8C2</Color>
    <Color x:Key="ColorTextMuted">#8D8D96</Color>
    <Color x:Key="ColorDisabled">#66666F</Color>

    <!-- Semantic -->
    <Color x:Key="ColorSuccess">#43C581</Color>
    <Color x:Key="ColorWarning">#FFB547</Color>
    <Color x:Key="ColorDanger">#F05D5E</Color>

    <!-- Chart accents -->
    <Color x:Key="ColorChartPurple">#7C5CFF</Color>
    <Color x:Key="ColorChartBlue">#5AA7FF</Color>
    <Color x:Key="ColorChartTeal">#3DD6C6</Color>
    <Color x:Key="ColorChartAmber">#FFC857</Color>

    <!-- Brushes (bind to these from XAML) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource ColorPrimaryPressed}" />

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="PopupBrush" Color="{StaticResource ColorPopup}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource ColorDisabled}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />

    <!-- Corner radius -->
    <CornerRadius x:Key="RadiusPopup">20</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusInput">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Type scale -->
    <x:Double x:Key="FontSizeDisplay">36</x:Double>
    <x:Double x:Key="FontSizeH1">28</x:Double>
    <x:Double x:Key="FontSizeH2">22</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">18</x:Double>
    <x:Double x:Key="FontSizeBody">16</x:Double>
    <x:Double x:Key="FontSizeSmall">14</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>

</ResourceDictionary>
