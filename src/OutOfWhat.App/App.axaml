<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OutOfWhatApp.App"
             RequestedThemeVariant="Dark">
             <!-- Dark-first per brand design principles. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OutOfWhatApp/Styles/Brand.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://OutOfWhatApp/Styles/Controls.axaml" />
    </Application.Styles>

    <!-- Tray icon is created in code (App.axaml.cs) so it can branch per-OS:
         macOS uses a native AppKit status item (see Platform/MacOS), since
         Avalonia's TrayIcon.Clicked never fires there. -->
</Application>
