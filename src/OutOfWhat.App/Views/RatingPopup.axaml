<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OutOfWhatApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="370"
        x:Class="OutOfWhatApp.Views.RatingPopup"
        x:DataType="vm:RatingViewModel"
        Width="350" Height="370"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="Inter"
        Topmost="True"
        Title="Out Of What">
    <Window.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
    </Window.Transitions>

    <Canvas>
        <!-- Single continuous outline: rounded-rect card with a triangular notch
             cut into its top edge. Built/updated in code (UpdateShape) since the
             notch position depends on the tray icon's runtime screen position. -->
        <Path x:Name="OutlinePath"
              Fill="{DynamicResource PopupBrush}"
              Stroke="{DynamicResource BorderBrush}"
              StrokeThickness="1"
              StrokeJoin="Round" />

        <Border Canvas.Top="20"
                Width="350"
                Height="350"
                Background="Transparent">
            <Grid RowDefinitions="Auto,Auto" VerticalAlignment="Top">
                <StackPanel Grid.Row="0"
                            Margin="24,40,24,0" Spacing="16"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <TextBlock Text="How was your day?"
                               FontSize="{DynamicResource FontSizeH2}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <TextBlock FontSize="{DynamicResource FontSizeBody}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center">
                        <Run Text="Out of" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Run Text="{Binding Denominator}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Medium" />
                    </TextBlock>

                    <TextBox Text="{Binding NumeratorText}"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             FontSize="{DynamicResource FontSizeDisplay}"
                             FontWeight="Medium" />

                    <TextBlock Text="{Binding ValidationError}"
                               IsVisible="{Binding HasValidationError}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding OverageWarning}"
                               IsVisible="{Binding HasOverageWarning}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               LineHeight="18"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,12,*">
                        <Button Grid.Column="0"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Classes="secondary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <Button Grid.Column="2"
                                Content="Log it"
                                Command="{Binding SaveCommand}"
                                Classes="primary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="24,30,24,24"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Image Source="avares://OutOfWhatApp/Assets/OOW.png"
                           Width="20" Height="20"
                           VerticalAlignment="Center" />

                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               LineHeight="18"
                               VerticalAlignment="Center"
                               TextAlignment="Left"><Run Text="A small daily check-in" /><LineBreak /><Run Text="that adds up over time." /></TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Canvas>
</Window>
